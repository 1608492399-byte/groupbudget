@model ActualImportPreviewViewModel
@{
    ViewData["Title"] = "决算导入预览";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">决算导入预览</h2>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-batchId="@Model.BudgetBatchId">取消并返回</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning">@Model.Message</div>
}
<div class="card mb-3">
    <div class="card-body">
        <div><strong>预算批次：</strong>@Model.BatchName</div>
        <div><strong>文件：</strong>@Model.FileName</div>
        <form asp-action="PreviewSheet" method="post" class="row g-2 align-items-end mt-2">
            <input type="hidden" name="token" value="@Model.Token" />
            <div class="col-md-5">
                <label for="sheetName" class="form-label">工作表</label>
                <select id="sheetName" name="sheetName" class="form-select">
                    @foreach (var sheetName in Model.SheetNames)
                    {
                        <option value="@sheetName" selected="@(sheetName == Model.SelectedSheetName)">@sheetName</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><button type="submit" class="btn btn-outline-primary">切换并重新预览</button></div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h4>@Model.TotalRows</h4><div class="text-muted">识别行数</div></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h4 class="text-success">@Model.SuccessRows</h4><div class="text-muted">可导入行数</div></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h4 class="text-danger">@Model.FailedRows</h4><div class="text-muted">失败行数</div></div></div></div>
</div>

@if (Model.HasExistingDetails)
{
    <div class="alert alert-warning">该预算批次已有决算导入数据。确认后将覆盖上一次导入，不会叠加。</div>
}
@if (Model.UnmatchedDepartments.Count > 0)
{
    <div class="alert alert-danger">
        <strong>未匹配部门（不会写入）：</strong>
        <ul class="mb-0">@foreach (var item in Model.UnmatchedDepartments) { <li>@item</li> }</ul>
    </div>
}
@if (Model.UnmappedSubjects.Count > 0)
{
    <div class="alert alert-danger">
        <strong>未映射会计科目（不会写入）：</strong>
        <ul class="mb-0">@foreach (var item in Model.UnmappedSubjects) { <li>@item</li> }</ul>
    </div>
}
@if (Model.Errors.Count > 0)
{
    <div class="alert alert-warning">
        <strong>错误报告：</strong>
        <ul class="mb-0">@foreach (var error in Model.Errors) { <li>@error</li> }</ul>
    </div>
}

<h5 class="mt-4">按部门与费用属性小计（按审定金额汇总写入决算）</h5>
<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light"><tr><th>部门</th><th>费用属性</th><th>行数</th><th>账套金额</th><th>调整金额</th><th>审定金额</th></tr></thead>
        <tbody>
        @foreach (var subtotal in Model.Subtotals)
        {
            <tr>
                <td>@subtotal.OrganizationName</td>
                <td>@subtotal.ExpenseType</td>
                <td class="text-end">@subtotal.RowCount</td>
                <td class="text-end">@subtotal.AccountAmount.ToString("N2")</td>
                <td class="text-end">@subtotal.AdjustmentAmount.ToString("N2")</td>
                <td class="text-end fw-bold">@subtotal.ApprovedAmount.ToString("N2")</td>
            </tr>
        }
        @if (Model.Subtotals.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">没有可汇总的有效行。</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.SuccessRows > 0)
{
    <form asp-action="Confirm" method="post" class="mt-3">
        <input type="hidden" name="token" value="@Model.Token" />
        @if (Model.HasExistingDetails)
        {
            <input type="hidden" name="overwritePrevious" value="true" />
            <button type="submit" class="btn btn-danger" onclick="return confirm('将覆盖该预算批次上一次决算导入，确认继续？');">覆盖上一次导入</button>
        }
        else
        {
            <button type="submit" class="btn btn-primary" onclick="return confirm('确认写入预览中的有效行并刷新草稿、已打回单据？');">确认导入</button>
        }
        <span class="text-muted small ms-2">失败行不会写入，错误已列出。</span>
    </form>
}

@model GroupBudget.ViewModels.HomeDashboardViewModel
@model GroupBudget.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "首页";
    ViewData["BodyClass"] = "home-body";
    var batch = Model.Batch;
    var statusPill = batch == null ? "pill-idle"
        : batch.Status == BatchStatus.Published ? "pill-live"
        : batch.Status == BatchStatus.Draft ? "pill-idle"
        : "pill-warn";
    var identityLine = Model.IsAuthenticated
        ? $"{Model.RoleName} · {(string.IsNullOrEmpty(Model.OrganizationName) ? "集团总部" : Model.OrganizationName)}"
        : "尚未登录 · 仅可查看概览";
    var flowCurrentStage = batch == null || batch.Status == BatchStatus.Draft ? 0
        : batch.Status == BatchStatus.Archived ? 4
        : Model.PendingCount > 0 ? 2
        : Model.FormApproved + Model.FormReturned > 0 ? 3
        : 1;
    var flowStages = new[]
    {
        new { Title = "草稿", Meta = $"{Model.FormDraft} 单待完善", Detail = "填报员在本部门工作区编制预算。草稿可持续修改，金额变动由系统计算。" },
        new { Title = "提交", Meta = $"{Model.FormSubmitted + Model.FormApproved + Model.FormReturned} / {Model.FormTotal} 单已提交", Detail = "填报完成后提交，系统记录版本与提交时间；超过偏差阈值时需填写说明。" },
        new { Title = "集团审核", Meta = $"{Model.PendingCount} 单待审核", Detail = "集团审核员核对部门预算与基准数据，可通过或退回并填写审核意见。" },
        new { Title = "审核结果", Meta = $"通过 {Model.FormApproved} · 退回 {Model.FormReturned}", Detail = "审核通过后进入归档准备；退回单据可按意见修订后重新提交。" },
        new { Title = "归档", Meta = batch?.Status == BatchStatus.Archived ? "批次已归档" : "等待批次归档", Detail = "批次归档后，相关预算版本与审核记录保留，汇总数据可供导出与追溯。" }
    };
}

<div class="home-page">

    <section class="hero">
        <div>
            <h1>
                预决算上报<br />
                <span class="thin">与审核系统</span>
            </h1>
            <p class="hero-lead">
                自然年度、一年一报。管理员统一下发本年预算与决算作为只读基准，
                各部门只填报次年预算；增减、增幅与合计一律由服务端计算，提交后留痕可追溯。
            </p>

            <div class="hero-actions">
                @if (!Model.IsAuthenticated)
                {
                    <a class="btn-ink" asp-area="Identity" asp-page="/Account/Login">
                        登录系统
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                    <a class="btn-line" href="#flow">查看报送流程</a>
                }
                else if (Model.IsFiller)
                {
                    <a class="btn-ink" asp-controller="Filing" asp-action="Index">
                        进入预算填报
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                    <a class="btn-line" asp-controller="ActualDetail" asp-action="Index">上年决算明细</a>
                    <a class="btn-quiet" asp-controller="Export" asp-action="All">导出本部门预算</a>
                }
                else
                {
                    <a class="btn-ink" asp-controller="Summary" asp-action="Index">
                        查看集团汇总表
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                    <a class="btn-line" asp-controller="Review" asp-action="Index">
                        集团审核
                        @if (Model.PendingCount > 0)
                        {
                            <span class="pill pill-live pill-sm">@Model.PendingCount</span>
                        }
                    </a>
                    <a class="btn-quiet" asp-controller="Export" asp-action="Index">导出汇总</a>
                }
            </div>

            <dl class="hero-meta">
                <div><dt>当前身份</dt><dd>@identityLine</dd></div>
                @if (batch != null)
                {
                    <div><dt>编制年度</dt><dd>@batch.PlanYear</dd></div>
                    <div><dt>基准年度</dt><dd>@batch.BaselineYear</dd></div>
                }
            </dl>
        </div>

        <aside class="ticket" aria-label="当前批次">
            <div class="ticket-head">
                <span class="label">当前批次</span>
                <span class="pill @statusPill">@(batch?.Status ?? "未创建")</span>
            </div>

            @if (batch == null)
            {
                <div class="ticket-rows">
                    <div><dt>批次</dt><dd>尚未创建</dd></div>
                </div>
                <div class="ticket-foot">
                    请使用管理员账号登录后，在「批次与基准」中创建批次并录入基准数据。
                </div>
            }
            else
            {
                <dl class="ticket-rows">
                    <div><dt>批次名称</dt><dd>@batch.Name</dd></div>
                    <div><dt>编制 / 基准年度</dt><dd>@batch.PlanYear / @batch.BaselineYear</dd></div>
                    <div><dt>基准版本</dt><dd>V@(batch.CurrentBaselineVersion)</dd></div>
                    <div><dt>偏差阈值</dt><dd>@batch.DeviationThreshold.ToString("P0")</dd></div>
                    <div><dt>下发时间</dt><dd>@(batch.PublishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
                </dl>

                <div class="ticket-progress">
                    <div class="cap">
                        <span>部门提交进度</span>
                        <b>@(Model.FormSubmitted + Model.FormApproved) / @Model.FormTotal</b>
                    </div>
                    <div class="meter"><i style="width:@(Model.ProgressPercent)%"></i></div>
                </div>

                <div class="ticket-foot">
                    待审核 @Model.PendingCount 单 · 已通过 @Model.FormApproved 单 · 打回 @Model.FormReturned 单
                </div>
            }
        </aside>
    </section>

    <section class="metrics" aria-label="关键指标">
        <div class="metric">
            <div class="k">填报部门</div>
            <div class="v">@Model.DepartmentCount<small>个</small></div>
            <div class="note">覆盖集团全部预算单元</div>
        </div>
        <div class="metric">
            <div class="k">预算科目</div>
            <div class="v">@Model.SubjectCount<small>项</small></div>
            <div class="note">末级科目，按部门限定适用范围</div>
        </div>
        <div class="metric">
            <div class="k">待集团审核</div>
            <div class="v">@Model.PendingCount<small>单</small></div>
            <div class="note">已提交、等待审核意见</div>
        </div>
        <div class="metric">
            <div class="k">@(batch?.PlanYear ?? 2027) 年预算合计</div>
            <div class="v">@Model.PlannedTotal.ToString("N2")<small>元</small></div>
            <div class="note">按部门已填报金额汇总</div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>快捷入口</h2>
            <span>已按当前身份筛选</span>
        </div>

        <div class="entries">
            @if (!Model.IsAuthenticated)
            {
                <a class="entry" asp-area="Identity" asp-page="/Account/Login">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" /></svg></span>
                    <span class="t">登录系统</span>
                    <span class="d">使用集团邮箱账号登录，按角色进入对应工作台。</span>
                    <span class="go"><b>去登录</b></span>
                </a>
                <a class="entry" asp-area="Identity" asp-page="/Account/Login">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg></span>
                    <span class="t">演示账号</span>
                    <span class="d">管理员、审核员、填报员三种角色，登录页可一键填入。</span>
                    <span class="go"><b>查看账号</b></span>
                </a>
                <a class="entry" href="#flow">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg></span>
                    <span class="t">报送流程</span>
                    <span class="d">从基准下达到审核归档，五步走完全年一次编制。</span>
                    <span class="go"><b>看流程</b></span>
                </a>
            }
            else if (Model.IsFiller)
            {
                <a class="entry" asp-controller="Filing" asp-action="Index">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg></span>
                    <span class="t">预算填报</span>
                    <span class="d">一行一科目填报次年预算，系统实时算出增减额与增幅。</span>
                    <span class="go"><b>当前状态：@(string.IsNullOrEmpty(Model.MyFormStatus) ? "未开始" : Model.MyFormStatus)</b></span>
                </a>
                <a class="entry" asp-controller="ActualDetail" asp-action="Index">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.2-3.2" /></svg></span>
                    <span class="t">上年决算明细</span>
                    <span class="d">按科目、月份逐笔核对本部门基准决算，填数前先看凭证。</span>
                    <span class="go"><b>钻取明细</b></span>
                </a>
                <a class="entry" asp-controller="Export" asp-action="All">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11M8 10l4 4 4-4" /><path d="M4 20h16" /></svg></span>
                    <span class="t">导出本部门预算</span>
                    <span class="d">生成基本支出与项目支出分块表，可直接用于内部汇报。</span>
                    <span class="go"><b>导出 CSV</b></span>
                </a>
            }
            else
            {
                <a class="entry" asp-controller="Summary" asp-action="Index">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 10v10" /></svg></span>
                    <span class="t">集团汇总表</span>
                    <span class="d">各部门基本支出与项目支出横向对比，含增减与增幅。</span>
                    <span class="go"><b>查看汇总</b></span>
                </a>
                <a class="entry" asp-controller="Review" asp-action="Index">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="8" /></svg></span>
                    <span class="t">集团审核</span>
                    <span class="d">待审 @Model.PendingCount 单；打回必须填写意见并留存版本。</span>
                    <span class="go"><b>去审核</b></span>
                </a>
                <a class="entry" asp-controller="ActualDetail" asp-action="Index">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.2-3.2" /></svg></span>
                    <span class="t">决算明细</span>
                    <span class="d">按部门、期间、费用属性筛选取数，可核对勾稽差额。</span>
                    <span class="go"><b>钻取明细</b></span>
                </a>
                <a class="entry" asp-controller="Export" asp-action="Index">
                    <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11M8 10l4 4 4-4" /><path d="M4 20h16" /></svg></span>
                    <span class="t">导出汇总</span>
                    <span class="d">集团总表与项目交叉表两种口径，一次导出归档。</span>
                    <span class="go"><b>去导出</b></span>
                </a>

                if (Model.IsAdmin)
                {
                    <a class="entry" asp-controller="Analytics" asp-action="Index">
                        <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg></span>
                        <span class="t">执行分析</span>
                        <span class="d">部门与类别的预算执行率、增减比例可视化，一眼看出超预算单位。</span>
                        <span class="go"><b>看图表</b></span>
                    </a>
                    <a class="entry" asp-controller="Admin" asp-action="Index">
                        <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7l8-4 8 4-8 4z" /><path d="M4 12l8 4 8-4M4 17l8 4 8-4" /></svg></span>
                        <span class="t">批次与基准</span>
                        <span class="d">录入本年预算与决算、下发锁定版本、调整偏差阈值。</span>
                        <span class="go"><b>管理批次</b></span>
                    </a>
                    <a class="entry" asp-controller="ActualImport" asp-action="Index">
                        <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17V6M8 10l4-4 4 4" /><path d="M4 20h16" /></svg></span>
                        <span class="t">决算导入</span>
                        <span class="d">按凭证流水导入决算明细，自动映射科目并校验合计。</span>
                        <span class="go"><b>导入数据</b></span>
                    </a>
                    <a class="entry" asp-controller="Admin" asp-action="SubjectScopes">
                        <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8" /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" /></svg></span>
                        <span class="t">科目部门范围</span>
                        <span class="d">限定人员费用、设施运营费等科目的适用部门，避免跨部门串数。</span>
                        <span class="go"><b>配置范围</b></span>
                    </a>
                }
            }
        </div>
    </section>

    <section class="panel" id="flow">
        <div class="panel-head">
            <h2>报送流程</h2>
            <span>自然年度 · 一年一报 · 全程留痕</span>
        </div>
        <div class="flow-summary">
            <span class="flow-current-label">当前阶段</span>
            <strong>@flowStages[flowCurrentStage].Title</strong>
            <span class="flow-summary-meta">@(batch == null ? "等待管理员创建批次" : $"{Model.FormTotal} 个填报单 · 进度 {Model.ProgressPercent}%")</span>
        </div>
        <div class="flow-progress" role="progressbar" aria-label="部门报送进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.ProgressPercent" aria-valuetext="@($"{Model.ProgressPercent}% 已提交或完成")">
            <span class="flow-progress-track" aria-hidden="true"><i style="width:@(Model.ProgressPercent)%"></i></span>
            <span class="flow-progress-value">@Model.ProgressPercent%</span>
        </div>
        <ol class="workflow" aria-label="预算报送工作流">
            @for (var i = 0; i < flowStages.Length; i++)
            {
                var stage = flowStages[i];
                <li class="workflow-item">
                    <button type="button" class="workflow-step @(i == flowCurrentStage ? "is-current is-selected" : "")"
                            data-title="@stage.Title" data-meta="@stage.Meta" data-detail="@stage.Detail"
                            aria-pressed="@(i == flowCurrentStage ? "true" : "false")" @(i == flowCurrentStage ? "aria-current=step" : null)>
                        <span class="workflow-index">0@(i + 1)</span>
                        <span class="workflow-title">@stage.Title</span>
                        <span class="workflow-meta">@stage.Meta</span>
                        @if (i == flowCurrentStage)
                        {
                            <span class="workflow-now">当前</span>
                        }
                        @if (i == 3)
                        {
                            <span class="workflow-branches"><span>通过 @Model.FormApproved</span><span>退回 @Model.FormReturned</span></span>
                        }
                    </button>
                </li>
            }
        </ol>
        <div class="workflow-detail" id="workflow-detail" aria-live="polite" aria-atomic="true">
            <span class="workflow-detail-kicker" id="workflow-detail-title">@flowStages[flowCurrentStage].Title</span>
            <p id="workflow-detail-copy">@flowStages[flowCurrentStage].Detail</p>
            <span class="workflow-detail-meta" id="workflow-detail-meta">@flowStages[flowCurrentStage].Meta</span>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        (() => {
            const steps = document.querySelectorAll('.workflow-step');
            const title = document.getElementById('workflow-detail-title');
            const copy = document.getElementById('workflow-detail-copy');
            const meta = document.getElementById('workflow-detail-meta');
            steps.forEach((step) => {
                step.addEventListener('click', () => {
                    steps.forEach((item) => {
                        item.classList.remove('is-selected');
                        item.setAttribute('aria-pressed', 'false');
                    });
                    step.classList.add('is-selected');
                    step.setAttribute('aria-pressed', 'true');
                    title.textContent = step.dataset.title;
                    copy.textContent = step.dataset.detail;
                    meta.textContent = step.dataset.meta;
                });
            });
        })();
    </script>
}

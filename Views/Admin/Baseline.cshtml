@model BaselineEditViewModel
@{
    ViewData["Title"] = "录入基准数据";
    var orgs = ViewBag.Organizations as List<Organization> ?? new List<Organization>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">录入 @Model.BaselineYear 年预算数 / 决算数</h2>
    <a class="btn btn-outline-secondary" asp-action="Index">返回批次列表</a>
</div>
<p class="text-muted">批次：@Model.BatchName · 当前状态 <strong>@Model.BatchStatus</strong> · 基准版本 <strong>V@(Model.CurrentVersion)</strong></p>

<div class="btn-group flex-wrap mb-3" role="group">
@foreach (var org in orgs)
{
    <a class="btn btn-sm @(org.Id == Model.OrganizationId ? "btn-primary" : "btn-outline-primary")"
       asp-action="Baseline" asp-route-batchId="@Model.BatchId" asp-route-orgId="@org.Id">@org.Name</a>
}
</div>

@if (Model.BatchStatus == BatchStatus.Closed || Model.BatchStatus == BatchStatus.Archived)
{
    <div class="alert alert-warning">批次已截止或归档，基准数据只读。</div>
}

<form asp-action="SaveBaseline" method="post">
    <input type="hidden" name="BatchId" value="@Model.BatchId" />
    <input type="hidden" name="OrganizationId" value="@Model.OrganizationId" />
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>费用类别</th>
                    <th>科目</th>
                    <th style="width:220px">@Model.BaselineYear 基本支出预算数（元）</th>
                    <th style="width:220px">@Model.BaselineYear 基本支出决算数（元）</th>
                    <th style="width:220px">@Model.BaselineYear 项目支出预算数（元）</th>
                    <th style="width:220px">@Model.BaselineYear 项目支出决算数（元）<br /><small class="text-muted">增减比较基数</small></th>
                </tr>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Rows.Count; i++)
            {
                <tr>
                    <input type="hidden" name="Rows[@i].SubjectId" value="@Model.Rows[i].SubjectId" />
                    <td class="small">@Model.Rows[i].Category</td>
                    <td>@Model.Rows[i].SubjectName</td>
                    <td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end"
                               name="Rows[@i].BudgetBaseline" value="@Model.Rows[i].BudgetBaseline.ToString("F2")"
                               @(Model.BatchStatus == BatchStatus.Closed || Model.BatchStatus == BatchStatus.Archived ? "readonly" : "") /></td>
                    <td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end"
                               name="Rows[@i].ActualBaseline" value="@Model.Rows[i].ActualBaseline.ToString("F2")"
                               @(Model.BatchStatus == BatchStatus.Closed || Model.BatchStatus == BatchStatus.Archived ? "readonly" : "") /></td>
                    <td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end"
                               name="Rows[@i].BudgetBaselineProject" value="@Model.Rows[i].BudgetBaselineProject.ToString("F2")"
                               @(Model.BatchStatus == BatchStatus.Closed || Model.BatchStatus == BatchStatus.Archived ? "readonly" : "") /></td>
                    <td><input type="text" inputmode="decimal" class="form-control form-control-sm text-end"
                               name="Rows[@i].ActualBaselineProject" value="@Model.Rows[i].ActualBaselineProject.ToString("F2")"
                               @(Model.BatchStatus == BatchStatus.Closed || Model.BatchStatus == BatchStatus.Archived ? "readonly" : "") /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.BatchStatus != BatchStatus.Closed && Model.BatchStatus != BatchStatus.Archived)
    {
        <button type="submit" class="btn btn-primary">保存本部门基准</button>
    }
</form>
<div class="alert alert-light border small mt-3">
    保存后还需在批次列表点「下发」，基准才会对部门可见。若批次已下发，保存将<strong>自动生成新版本并留痕</strong>，不影响已提交单据。
</div>

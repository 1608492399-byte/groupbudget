@model FilingEditViewModel

@{
    var groups = Model.Lines
        .GroupBy(x => x.Category ?? "其他")
        .ToList();
}

<table class="table table-sm table-bordered align-middle mb-0">
    <thead class="table-light text-center">
        <tr>
            <th style="width:110px">费用类别</th>
            <th style="width:52px">序号</th>
            <th style="width:180px">预算科目</th>
            <th class="text-end" style="width:130px">@(Model.BaselineYear) 预算数<br /><small class="text-muted">只读</small></th>
            <th class="text-end" style="width:130px">@(Model.BaselineYear) 决算数<br /><small class="text-muted">只读 · 比较基数</small></th>
            <th class="text-end" style="width:140px">@Model.PlanYear 预算数<br /><small class="text-muted">@(Model.ReadOnly ? "已锁定" : "可填")</small></th>
            <th class="text-end" style="width:120px">增减额</th>
            <th class="text-end" style="width:100px">增幅</th>
            <th style="width:200px">增减原因</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in groups)
        {
            var rows = group.ToList();
            for (var r = 0; r < rows.Count; r++)
            {
                var line = rows[r];
                <tr>
                    @if (r == 0)
                    {
                        <td rowspan="@rows.Count" class="category-cell">@group.Key</td>
                    }
                    <td class="text-center text-muted">@(r + 1).</td>
                    <td>
                        @line.SubjectName
                        @if (line.NeedsReason)
                        {
                            <span class="badge bg-warning text-dark ms-1">需说明</span>
                        }
                    </td>
                    <td class="text-end text-muted">@line.Budget2026.ToString("N2")</td>
                    <td class="text-end text-muted">
                        @if (line.Actual2026 != 0m)
                        {
                            <a class="text-decoration-none" title="点击查看该科目的凭证级决算明细"
                               style="border-bottom:1px dashed #0d6efd;color:#0d6efd;"
                               asp-controller="ActualDetail" asp-action="Index"
                               asp-route-batchId="@Model.BatchId"
                               asp-route-orgId="@Model.OrganizationId"
                               asp-route-subjectId="@line.SubjectId"
                               asp-route-expenseType="@line.ExpenseType">@line.Actual2026.ToString("N2")</a>
                        }
                        else
                        {
                            @line.Actual2026.ToString("N2")
                        }
                    </td>
                    <td class="text-end">
                        @if (Model.ReadOnly)
                        {
                            <strong>@line.Budget2027.ToString("N2")</strong>
                        }
                        else
                        {
                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-end"
                                   name="Lines[@Model.Lines.IndexOf(line)].Budget2027" value="@line.Budget2027.ToString("F2")" />
                            @Html.ValidationMessage($"Lines[{Model.Lines.IndexOf(line)}].Budget2027", "", new { @class = "text-danger small" })
                        }
                    </td>
                    <td class="text-end">
                        @if (line.ChangeAmount > 0)
                        {
                            <span class="text-danger">+@line.ChangeAmount.ToString("N2")</span>
                        }
                        else if (line.ChangeAmount < 0)
                        {
                            <span class="text-success">@line.ChangeAmount.ToString("N2")</span>
                        }
                        else
                        {
                            <span>0.00</span>
                        }
                    </td>
                    <td class="text-end">
                        @(line.ChangeRate.HasValue ? line.ChangeRate.Value.ToString("P2") : "—")
                    </td>
                    <td>
                        @if (Model.ReadOnly)
                        {
                            <span class="small">@line.Reason</span>
                        }
                        else
                        {
                            <input type="text" class="form-control form-control-sm" maxlength="500"
                                   name="Lines[@Model.Lines.IndexOf(line)].Reason" value="@line.Reason" placeholder="偏差超阈值时必填" />
                            @Html.ValidationMessage($"Lines[{Model.Lines.IndexOf(line)}].Reason", "", new { @class = "text-danger small" })
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td colspan="3" class="text-end">合计（服务端计算）</td>
            <td class="text-end">@Model.TotalBudget2026.ToString("N2")</td>
            <td class="text-end">@Model.TotalActual2026.ToString("N2")</td>
            <td class="text-end">@Model.TotalBudget2027.ToString("N2")</td>
            <td class="text-end">@Model.TotalChange.ToString("N2")</td>
            <td class="text-end">@(Model.TotalChangeRate?.ToString("P2") ?? "—")</td>
            <td></td>
        </tr>
    </tfoot>
</table>
<div class="form-text mt-2">
    口径：增减额 = @Model.PlanYear 预算数 − @Model.BaselineYear 决算数；增幅 = 增减额 ÷ @Model.BaselineYear 决算数（决算为 0 时留空）。
    偏差超过 @Model.DeviationThreshold.ToString("P0") 的行必须填写增减原因。@Model.BaselineYear 两列由管理员下发并锁定，接口层拒绝任何修改。
</div>

<style>
    .category-cell {
        background: #f8f9fa;
        font-weight: 600;
        text-align: center;
        vertical-align: middle !important;
        color: #0d6efd;
        white-space: normal;
    }
</style>

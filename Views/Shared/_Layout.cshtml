<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 光华集团预决算上报审核系统</title>
    <script>
        document.documentElement.classList.add('js-enabled');
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        window.addEventListener('pageshow', () => window.scrollTo(0, 0), { once: true });
        // 动效层：系统开了「减少动态效果」就不上初始隐藏态，内容直接可见
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('motion-ready');
        }
        // 兜底：motion.js 没跑起来就把隐藏态摘掉，绝不把内容藏死
        setTimeout(function () {
            if (!window.__gbMotion) document.documentElement.classList.remove('motion-ready');
        }, 2600);
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/viz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    @{
        var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "";
        Func<string, string> railClass = c =>
            string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) ? "qr-item is-active" : "qr-item";
    }
    <aside class="quickrail" id="quickrail" aria-label="快捷导航">
        <a class="@railClass("Home")" asp-controller="Home" asp-action="Index" title="首页" aria-label="首页">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.2 10 3l7 6.2V17a1 1 0 0 1-1 1h-4v-5H8v5H4a1 1 0 0 1-1-1z" /></svg>
            <span>首页</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (User.IsInRole(AppRoles.Filler))
            {
                <a class="@railClass("Filing")" asp-controller="Filing" asp-action="Index" title="预算填报" aria-label="预算填报">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h6l4 4v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" /><path d="M11 3v4h4" /><path d="M7 12h6" /><path d="M7 15h4" /></svg>
                    <span>预算填报</span>
                </a>
                <a class="@railClass("ActualDetail")" asp-controller="ActualDetail" asp-action="Index" title="上年决算明细" aria-label="上年决算明细">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h12" /><path d="M4 10h12" /><path d="M4 15h8" /></svg>
                    <span>上年决算</span>
                </a>
            }
            @if (User.IsInRole(AppRoles.Reviewer) || User.IsInRole(AppRoles.Admin))
            {
                <a class="@railClass("Summary")" asp-controller="Summary" asp-action="Index" title="集团汇总表" aria-label="集团汇总表">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="1.2" /><path d="M3 8h14" /><path d="M8 8v8" /></svg>
                    <span>集团汇总</span>
                </a>
                <a class="@railClass("Review")" asp-controller="Review" asp-action="Index" title="集团审核" aria-label="集团审核">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7" /><path d="M6.6 10.2 9 12.5l4.4-4.6" /></svg>
                    <span>集团审核</span>
                </a>
            }
            @if (User.IsInRole(AppRoles.Admin))
            {
                <a class="@railClass("Analytics")" asp-controller="Analytics" asp-action="Index" title="执行分析" aria-label="执行分析">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 17h14" /><path d="M5.5 17V9.5" /><path d="M10 17V5" /><path d="M14.5 17v-5" /></svg>
                    <span>执行分析</span>
                </a>
                <a class="@railClass("Admin")" asp-controller="Admin" asp-action="Index" title="批次与基准" aria-label="批次与基准">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6.5h14" /><path d="M3 13.5h14" /><circle cx="7.5" cy="6.5" r="1.9" /><circle cx="13" cy="13.5" r="1.9" /></svg>
                    <span>批次与基准</span>
                </a>
                <a class="@railClass("Export")" asp-controller="Export" asp-action="Index" title="导出汇总" aria-label="导出汇总">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9" /><path d="M6.4 8.6 10 12.2l3.6-3.6" /><path d="M4 16h12" /></svg>
                    <span>导出汇总</span>
                </a>
            }
        }
        <button type="button" class="qr-pin" title="固定展开" aria-label="固定展开" aria-pressed="false">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="7" r="3.1" /><path d="M10 10.1V16.5" /></svg>
            <span>固定展开</span>
        </button>
    </aside>
    <header>
        <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">光华集团预决算上报审核系统</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">首页</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(AppRoles.Filler))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Filing" asp-action="Index">预算填报</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="ActualDetail" asp-action="Index">上年决算明细</a></li>
                            }
                            @if (User.IsInRole(AppRoles.Reviewer) || User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Summary" asp-action="Index">集团汇总表</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="ActualDetail" asp-action="Index">决算明细</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Review" asp-action="Index">集团审核</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Export" asp-action="Index">导出汇总</a></li>
                            }
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Analytics" asp-action="Index">执行分析</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">批次与基准</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="ActualImport" asp-action="Index">决算导入</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Accounts">演示账号</a></li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4">内部系统 · 金额单位：元 · 所有操作留痕</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    <script>
        (() => {
            const rail = document.getElementById('quickrail');
            if (!rail) return;
            const pin = rail.querySelector('.qr-pin');
            let pinned = false;
            let timer;

            const open = () => { clearTimeout(timer); rail.classList.add('is-open'); };
            const close = () => {
                if (pinned) return;
                if (rail.matches(':hover') || rail.contains(document.activeElement)) return;
                rail.classList.remove('is-open');
            };
            const schedule = () => { clearTimeout(timer); timer = setTimeout(close, 1200); };

            rail.addEventListener('mouseenter', open);
            rail.addEventListener('mouseleave', schedule);
            rail.addEventListener('focusin', open);
            rail.addEventListener('focusout', schedule);

            pin?.addEventListener('click', () => {
                pinned = !pinned;
                rail.classList.toggle('is-pinned', pinned);
                pin.setAttribute('aria-pressed', String(pinned));
                pin.title = pinned ? '取消固定' : '固定展开';
                pin.setAttribute('aria-label', pin.title);
                if (pinned) open(); else schedule();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

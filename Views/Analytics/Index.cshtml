@model GroupBudget.ViewModels.ExecutionAnalysisViewModel
@using System.Globalization
@{
    ViewData["Title"] = "执行分析";
    ViewData["BodyClass"] = "viz-body";

    var batch = Model.Batch;
    var inv = CultureInfo.InvariantCulture;

    Func<decimal?, string> pct = v => v == null ? "—" : (v.Value * 100).ToString("0.0", inv) + "%";
    Func<decimal?, string> pctSigned = v => v == null ? "—" : (v.Value > 0 ? "+" : "") + (v.Value * 100).ToString("0.0", inv) + "%";
    Func<decimal, string> money = v => v.ToString("N2", inv);
    Func<decimal?, string> changeClass = v => v == null ? "muted" : v.Value > 0 ? "up" : v.Value < 0 ? "down" : "muted";

    // —— 柱状图几何：仅两个系列（本年预算 / 次年预算） ——
    var depts = Model.ChartDepartments;
    var chartWidth = 1120m;
    var chartLeft = 104m;
    var chartRight = 1092m;
    var chartTop = 30m;
    var chartBaseline = 344m;
    var plotHeight = chartBaseline - chartTop;
    var chartMax = Math.Max(1m, depts.SelectMany(d => new[] { d.Budget, d.Plan }).DefaultIfEmpty(0m).Max() * 1.12m);
    var groupWidth = (chartRight - chartLeft) / Math.Max(1, depts.Count);
    var barWidth = Math.Min(26m, groupWidth * 0.26m);
    var barGap = 6m;

    // —— 饼图几何：用 stroke-dasharray 画环，避免手算贝塞尔路径 ——
    var pieRadius = 54m;
    var pieCircumference = 2m * (decimal)Math.PI * pieRadius;
    var pieColors = new[] { "#11161b", "#33405a", "#5b6b86", "#8290a6", "#a8b2c1", "#c7ced8", "#dde2e8", "#eef0f3" };
    var pieConsumed = 0m;
}

<div class="viz-page">

    <header class="viz-head">
        <div>
            <p class="eyebrow">管理员 · 预算分析</p>
            <h1>执行分析与次年预算</h1>
            <p class="sub">
                @if (batch != null)
                {
                    <b>@batch.Name</b>
                    <text> · 基准年 @batch.BaselineYear ／ 编制年 @batch.PlanYear · 基准版本 V@(batch.CurrentBaselineVersion)</text>
                }
                else
                {
                    <text>尚未创建批次</text>
                }
            </p>
        </div>

        <div class="head-actions">
            <div class="unit-toggle" role="group" aria-label="金额单位">
                <button type="button" class="unit-btn is-active" data-unit="yuan" aria-pressed="true">元</button>
                <button type="button" class="unit-btn" data-unit="wan" aria-pressed="false">万元</button>
            </div>
            <a class="viz-btn" asp-controller="Summary" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18M9 10v10" /></svg>
                集团汇总表
            </a>
            <button type="button" class="viz-btn" onclick="window.print()">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><rect x="4" y="8" width="16" height="8" rx="2" /><path d="M7 16h10v5H7z" /></svg>
                打印
            </button>
        </div>
    </header>

    @if (batch == null)
    {
        <div class="viz-empty">尚未创建批次。请先在「批次与基准」中创建批次并录入基准数据，再回到本页查看分析。</div>
    }
    else
    {
        <!-- ================= 文字总结（置于图表之前） ================= -->
        <section class="insight-summary insight-lead" aria-live="polite" aria-atomic="true">
            <span class="insight-label">数据摘要</span>
            <p>@Model.InsightSummary</p>
        </section>

        <!-- ================= KPI ================= -->
        <section class="viz-kpi" aria-label="关键指标">
            <div class="kpi">
                <div class="k metric-label">@batch.BaselineYear 年预算</div>
                <div class="v"><span class="metric-value" data-yuan="@Model.BudgetTotal.ToString(inv)">@money(Model.BudgetTotal)</span><small data-unit-label>元</small></div>
                <div class="note">基准预算 · 不含总裁办</div>
            </div>
            <div class="kpi">
                <div class="k metric-label">@batch.BaselineYear 年决算</div>
                <div class="v"><span class="metric-value" data-yuan="@Model.ActualTotal.ToString(inv)">@money(Model.ActualTotal)</span><small data-unit-label>元</small></div>
                <div class="note">实际发生数 · 含总裁办</div>
            </div>
            <div class="kpi">
                <div class="k metric-label">@batch.PlanYear 年预算</div>
                <div class="v"><span class="metric-value" data-yuan="@Model.PlanTotal.ToString(inv)">@money(Model.PlanTotal)</span><small data-unit-label>元</small></div>
                <div class="note">部门填报合计</div>
            </div>
            <div class="kpi">
                <div class="k metric-label">@batch.BaselineYear 年执行率</div>
                <div class="v"><span class="metric-value metric-rate">@pct(Model.ExecRate)</span></div>
                <div class="note">决算 ÷ 预算，未年化</div>
            </div>
        </section>

        <!-- ================= 部门预算对照：仅本年预算与次年预算 ================= -->
        <section class="viz-card" aria-labelledby="department-chart-title">
            <div class="viz-card-head">
                <div>
                    <h2 id="department-chart-title">@batch.BaselineYear 与 @batch.PlanYear 年预算对照</h2>
                    <div class="hint">按 @batch.BaselineYear 年预算由高到低排序，不含决算数</div>
                </div>
            </div>
            <div class="chart-legend" aria-label="图表系列">
                <span><i class="series-budget"></i>@batch.BaselineYear 年预算</span>
                <span><i class="series-plan"></i>@batch.PlanYear 年预算</span>
            </div>
            <div class="chart-scroll" tabindex="0" role="region" aria-label="部门预算对照图表，可左右滚动">
                <svg class="department-chart" viewBox="0 0 @chartWidth 420" role="img" aria-labelledby="department-chart-title department-chart-desc">
                    <desc id="department-chart-desc">各部门 @batch.BaselineYear 年与 @batch.PlanYear 年预算对照。相同数据以表格形式提供。</desc>
                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var y = chartBaseline - plotHeight * tick / 4m;
                        var value = chartMax * tick / 4m;
                        <line class="chart-gridline" x1="@chartLeft" x2="@chartRight" y1="@y" y2="@y" />
                        @:<text class="chart-axis-label" data-yuan="@value.ToString(inv)" x="@((chartLeft - 10m).ToString(inv))" y="@((y + 4m).ToString(inv))" text-anchor="end">@money(value)</text>
                    }
                    @if (depts.Count == 0)
                    {
                        @:<text class="chart-empty" x="560" y="200" text-anchor="middle">暂无数据</text>
                    }
                    @for (var i = 0; i < depts.Count; i++)
                    {
                        var d = depts[i];
                        var center = chartLeft + groupWidth * (i + .5m);
                        var totalWidth = barWidth * 2m + barGap;
                        var start = center - totalWidth / 2m;
                        var hBudget = d.Budget == 0m ? 0m : d.Budget / chartMax * plotHeight;
                        var hPlan = d.Plan == 0m ? 0m : d.Plan / chartMax * plotHeight;
                        <g class="chart-group" style="--bar-delay:@(i * 28)ms">
                            <title>@d.Name：@batch.BaselineYear 预算 @money(d.Budget) 元，@batch.PlanYear 预算 @money(d.Plan) 元</title>
                            @if (hBudget > 0m)
                            {
                                <rect class="chart-bar series-budget-bar" data-yuan="@d.Budget.ToString(inv)" x="@start" y="@(chartBaseline - hBudget)" width="@barWidth" height="@hBudget" />
                            }
                            else
                            {
                                <line class="chart-zero-tick" x1="@start" x2="@(start + barWidth)" y1="@chartBaseline" y2="@chartBaseline" />
                            }
                            @if (hPlan > 0m)
                            {
                                <rect class="chart-bar series-plan-bar" data-yuan="@d.Plan.ToString(inv)" x="@(start + barWidth + barGap)" y="@(chartBaseline - hPlan)" width="@barWidth" height="@hPlan" />
                            }
                            else
                            {
                                <line class="chart-zero-tick" x1="@(start + barWidth + barGap)" x2="@(start + barWidth * 2m + barGap)" y1="@chartBaseline" y2="@chartBaseline" />
                            }
                            <text class="chart-department-label" x="@center" y="372" text-anchor="middle">@d.Name</text>
                        </g>
                    }
                </svg>
            </div>
            <div class="chart-scroll-hint">图表可左右滑动查看完整部门</div>
            <table class="visually-hidden" aria-live="polite">
                <caption>部门预算对照数据</caption>
                <thead><tr><th>部门</th><th>@batch.BaselineYear 预算</th><th>@batch.PlanYear 预算</th></tr></thead>
                <tbody>
                    @foreach (var d in depts)
                    {
                        <tr><th>@d.Name</th><td>@money(d.Budget)</td><td>@money(d.Plan)</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- ================= 饼图 + 预算科目对照 ================= -->
        <div class="chart-grid">
            <section class="viz-card" aria-labelledby="pie-title">
                <div class="viz-card-head">
                    <div>
                        <h2 id="pie-title">@batch.BaselineYear 年@(Model.PieBasis)构成</h2>
                        <div class="hint">按预算科目汇总 · 仅显示金额前 7 位，其余并入「其他科目」</div>
                    </div>
                </div>
                <div class="pie-layout">
                    <svg class="pie-svg" viewBox="0 0 150 150" role="img" aria-labelledby="pie-title pie-desc">
                        <desc id="pie-desc">各预算科目在@(Model.PieBasis)总额中的占比。</desc>
                        <circle class="pie-track" cx="75" cy="75" r="54" />
                        @if (Model.PieTotal > 0m)
                        {
                            foreach (var slice in Model.PieSlices)
                            {
                                var share = slice.Share ?? 0m;
                                var length = share * pieCircumference;
                                var offset = -pieConsumed;
                                pieConsumed += length;
                                var color = pieColors[Model.PieSlices.IndexOf(slice) % pieColors.Length];
                                <circle class="pie-slice"
                                        cx="75" cy="75" r="54"
                                        stroke="@color"
                                        stroke-dasharray="@length.ToString("0.##", inv) @pieCircumference.ToString("0.##", inv)"
                                        stroke-dashoffset="@offset.ToString("0.##", inv)"
                                        aria-label="@slice.Name：@money(slice.Amount) 元，占比 @((share * 100).ToString("0.0", inv))%">
                                    <title>@slice.Name：@money(slice.Amount) 元（@((share * 100).ToString("0.0", inv))%）</title>
                                </circle>
                            }
                        }
                        <text class="pie-total" x="75" y="74" text-anchor="middle" data-yuan="@Model.PieTotal.ToString(inv)">@money(Model.PieTotal)</text>
                        <text class="pie-caption" x="75" y="90" text-anchor="middle">合计 · <tspan data-unit-label>元</tspan></text>
                    </svg>
                    <ul class="pie-legend">
                        @for (var i = 0; i < Model.PieSlices.Count; i++)
                        {
                            var slice = Model.PieSlices[i];
                            <li class="@(slice.IsOther ? "is-other" : "")">
                                <i style="background-color:@pieColors[i % pieColors.Length]"></i>
                                <span>@slice.Name</span>
                                <b data-yuan="@slice.Amount.ToString(inv)">@money(slice.Amount)</b>
                                <em>@(((slice.Share ?? 0m) * 100m).ToString("0.0", inv))%</em>
                            </li>
                        }
                        @if (Model.PieSlices.Count == 0)
                        {
                            <li class="pie-empty">暂无数据</li>
                        }
                    </ul>
                </div>
            </section>

            <section class="viz-card" aria-labelledby="subject-table-title">
                <div class="viz-card-head">
                    <div>
                        <h2 id="subject-table-title">预算科目对照</h2>
                        <div class="hint">按 @batch.BaselineYear 年决算由高到低排序，共 @Model.Subjects.Count 个科目；备注取自《部门支出预算执行总表》说明列</div>
                    </div>
                </div>
                <div class="viz-table-wrap viz-table-scroll">
                    <table class="viz-table">
                        <thead>
                            <tr>
                                <th>预算科目</th>
                                <th>@batch.BaselineYear 预算</th>
                                <th>@batch.BaselineYear 决算</th>
                                <th>执行率</th>
                                <th>@batch.PlanYear 预算</th>
                                <th>增减比例</th>
                                <th class="remark-h">备注</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Subjects)
                            {
                                <tr title="费用类别：@s.Note">
                                    <td>@s.Name</td>
                                    <td class="num" data-yuan="@s.Budget.ToString(inv)">@money(s.Budget)</td>
                                    <td class="num" data-yuan="@s.Actual.ToString(inv)">@money(s.Actual)</td>
                                    <td class="@(s.ExecRate > 1m ? "up" : "")">@pct(s.ExecRate)</td>
                                    <td class="num" data-yuan="@s.Plan.ToString(inv)">@money(s.Plan)</td>
                                    <td class="@changeClass(s.ChangeRate)">@pctSigned(s.ChangeRate)</td>
                                    <td class="remark">@(string.IsNullOrWhiteSpace(s.Remark) ? "—" : s.Remark)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>合计</td>
                                <td class="num" data-yuan="@Model.BudgetTotal.ToString(inv)">@money(Model.BudgetTotal)</td>
                                <td class="num" data-yuan="@Model.ActualTotal.ToString(inv)">@money(Model.ActualTotal)</td>
                                <td>@pct(Model.ExecRate)</td>
                                <td class="num" data-yuan="@Model.PlanTotal.ToString(inv)">@money(Model.PlanTotal)</td>
                                <td class="@changeClass(Model.PlanChangeRate)">@pctSigned(Model.PlanChangeRate)</td>
                                <td class="remark"></td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="scroll-hint">表格较宽，可左右滑动查看完整列</div>
                </div>
            </section>
        </div>

        <!-- ================= 部门执行率 ================= -->
        <section class="viz-card">
            <div class="viz-card-head">
                <div>
                    <h2>部门预算执行率</h2>
                    <div class="hint">@batch.BaselineYear 年决算 ÷ 预算；竖线为 100%，越过竖线即超预算</div>
                </div>
                <div class="legend">
                    <span class="lg-muted"><i></i>预算内</span>
                    <span class="lg-up"><i></i>超预算</span>
                </div>
            </div>

            <div class="bars">
                @foreach (var d in Model.Departments)
                {
                    var w = d.ExecRate == null ? 0m : d.ExecRate.Value / Model.ExecScale;
                    <div class="bar-row">
                        <div class="name">@d.Name</div>
                        <div class="bar-track">
                            @if (d.ExecRate != null)
                            {
                                <div class="bar-fill @(d.ExecRate > 1m ? "over" : "")" style="width:@((w * 100m).ToString("0.##", inv))%"></div>
                            }
                            <div class="ref" style="left:@((100m / Model.ExecScale).ToString("0.##", inv))%"></div>
                        </div>
                        <div class="bar-value">
                            <b class="@(d.ExecRate > 1m ? "up" : "")">@pct(d.ExecRate)</b>
                            <span>决算 <i class="inline-amount" data-yuan="@d.Actual.ToString(inv)">@money(d.Actual)</i></span>
                        </div>
                    </div>
                }
            </div>
            <div class="hint" style="margin-top:12px">
                人员费用已归口人事部：人事部的预算与决算都包含全集团人员费用，其余部门只统计本部门非人员费用。
            </div>
        </section>

        <div class="viz-foot">
            <div><b>口径</b>：决算 @money(Model.ActualTotal) 元。@Model.CaliberNote 人员费用按预算归属统一计入人事部。</div>
            <div><b>执行率</b> ＝ @batch.BaselineYear 年决算 ÷ @batch.BaselineYear 年预算；决算为 1–10 月实际发生数，未按 12 个月年化。</div>
            <div><b>增减比例</b> ＝（@batch.PlanYear 年预算 − @batch.BaselineYear 年决算）÷ @batch.BaselineYear 年决算。</div>
            @if (Model.ExcludedDepartments.Count > 0)
            {
                <div><b>范围</b>：@(string.Join("、", Model.ExcludedDepartments))的预算为 0，不作为部门行出现在图表中；其决算 @money(Model.ExcludedActualTotal) 元已计入集团合计与科目汇总，因此合计仍与汇总表一致。</div>
            }
            <div><b>填报状态</b>：@(Model.HasPlan ? $"已录入 {batch.PlanYear} 年预算。" : $"{batch.PlanYear} 年预算尚未填报，增减对照暂不可用。")</div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (() => {
            // —— 元 / 万元 切换：所有带 data-yuan 的元素统一换算，不重新请求 ——
            const fmt = new Intl.NumberFormat('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const buttons = Array.from(document.querySelectorAll('.unit-btn'));
            const labels = Array.from(document.querySelectorAll('[data-unit-label]'));

            const apply = (unit) => {
                const divide = unit === 'wan' ? 10000 : 1;
                document.querySelectorAll('[data-yuan]').forEach((el) => {
                    const value = Number(el.dataset.yuan);
                    if (!Number.isFinite(value)) return;
                    el.textContent = fmt.format(value / divide);
                });
                labels.forEach((el) => { el.textContent = unit === 'wan' ? '万元' : '元'; });
                buttons.forEach((btn) => {
                    const active = btn.dataset.unit === unit;
                    btn.classList.toggle('is-active', active);
                    btn.setAttribute('aria-pressed', String(active));
                });
                try { localStorage.setItem('gb-amount-unit', unit); } catch { /* 隐私模式下忽略 */ }
            };

            buttons.forEach((btn) => btn.addEventListener('click', () => apply(btn.dataset.unit)));

            let saved = 'yuan';
            try { saved = localStorage.getItem('gb-amount-unit') || 'yuan'; } catch { /* 忽略 */ }
            if (saved === 'wan') apply('wan');
        })();
    </script>
}
